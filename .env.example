# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web application)
# Used for BOTH Google Drive backup and "Sign in with Google" — add BOTH of
# these as Authorized redirect URIs on the same OAuth client (swap the host
# for your real domain in production):
#   http://localhost:3000/api/drive/callback           (Drive backup — must match GOOGLE_REDIRECT_URI exactly)
#   http://localhost:3000/api/auth/google/callback      (Sign in with Google — built from the request, no env var needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the server listens on (most cloud hosts set this for you automatically).
PORT=3000

# Where the SQLite database file lives. Leave unset for local dev (defaults
# to backend/db/lifetracker.sqlite). On most cloud hosts, the filesystem is
# wiped on every redeploy unless you attach a persistent volume/disk — set
# this to a path inside that mounted volume, e.g.:
#   DB_PATH=/data/lifetracker.sqlite
DB_PATH=

# Set NODE_ENV=production when deployed so session cookies require HTTPS.
NODE_ENV=development

# Path to a Chromium-family browser binary, used to render PDF/image reports.
# Only needed if none of the common install locations are found automatically
# (see backend/reports/visual.js) — typical on most cloud hosts, e.g.:
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=

# Claude API key, used for the "✨ AI Insights" button on the Actions page
# (task prioritization + suggested next steps). Get one at
# https://console.anthropic.com/settings/keys. Leave blank to disable the
# feature — it shows "not configured on this server" instead, same as
# Google Drive backup above.
ANTHROPIC_API_KEY=

# Sends the daily email digest (overdue / due today / due tomorrow) via
# Gmail SMTP, once a day at 07:00 server time, to any user who's turned it
# on in Settings. GMAIL_USER is the Gmail address to send from; the
# password is NOT your normal Gmail password — generate an "App Password"
# at myaccount.google.com/apppasswords (requires 2-Step Verification to be
# on for that Google account). Leave both blank to disable the feature —
# the scheduler just logs that it's skipping and does nothing.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The public URL of this deployment — used as the "Open Waypoint" link in
# digest emails, since a background email job has no incoming request to
# derive it from. Defaults to http://localhost:3000 if unset.
APP_URL=
