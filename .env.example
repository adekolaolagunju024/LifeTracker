# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web application)
# Used for BOTH Google Drive backup and "Sign in with Google" — add BOTH of
# these as Authorized redirect URIs on the same OAuth client (swap the host
# for your real domain in production):
#   http://localhost:3000/api/drive/callback           (Drive backup — must match GOOGLE_REDIRECT_URI exactly)
#   http://localhost:3000/api/auth/google/callback      (Sign in with Google — built from the request, no env var needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the server listens on (most cloud hosts set this for you automatically).
PORT=3000

# Where the SQLite database file lives. Leave unset for local dev (defaults
# to backend/db/lifetracker.sqlite). On most cloud hosts, the filesystem is
# wiped on every redeploy unless you attach a persistent volume/disk — set
# this to a path inside that mounted volume, e.g.:
#   DB_PATH=/data/lifetracker.sqlite
# Uploaded files (photos, attachments) go in an "uploads" folder beside it,
# and the nightly backups in a "backups" folder. UPLOAD_DIR overrides.
DB_PATH=

# Off-site backups. The nightly backup sits on the same volume as the
# database; set these and each night's copy (compressed) and any new
# uploaded files are also sent to S3-compatible storage elsewhere, e.g. a
# Cloudflare R2 bucket. Set a lifecycle rule on the bucket to delete copies
# after, say, 30 days. Leave blank to keep backups on the volume only.
#   BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto

# Set NODE_ENV=production when deployed so session cookies require HTTPS.
NODE_ENV=development

# Path to a Chromium-family browser binary, used to render PDF/image reports.
# Only needed if none of the common install locations are found automatically
# (see backend/reports/visual.js) — typical on most cloud hosts, e.g.:
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=

# Claude API key, used for "✨ AI Insights", "Chat with AI" project creation,
# and weekly goal check-ins. Get one at
# https://console.anthropic.com/settings/keys. Leave blank to disable all
# three — they show "not configured on this server" instead, same as
# Google Drive backup above.
ANTHROPIC_API_KEY=

# Optional free-tier fallback for the same three AI features, used instead
# of Anthropic when AI_PROVIDER=gemini, or automatically when
# ANTHROPIC_API_KEY is blank but this is set. Get a free key at
# https://aistudio.google.com/apikey (no card required for the free tier).
GEMINI_API_KEY=
AI_PROVIDER=

# Powers every outgoing email: the daily digest, Activity Emails, and
# chat-message email-out. Sent via Resend's API (resend.com) rather than
# raw SMTP — most PaaS hosts (Railway included) block outbound SMTP ports
# entirely below their paid tiers, which plain nodemailer+Gmail can't get
# around no matter how correct the credentials are; Resend sends over
# ordinary HTTPS instead, so it isn't affected. Sign up free (3,000
# emails/month, no card required) and create an API key at
# resend.com/api-keys. Leave blank to disable all three features — each
# just logs that it's skipping and does nothing.
RESEND_API_KEY=
# The "from" address emails are sent as. Without verifying your own domain
# in Resend, you MUST leave this unset — it defaults to Resend's sandbox
# sender (onboarding@resend.dev), which only delivers to the email address
# on your own Resend account (fine for the digest/Activity Emails you get
# about your own tasks, not for emailing other collaborators). Verify a
# domain at resend.com/domains and set this to an address on it (e.g.
# Wayrise <noreply@yourdomain.com>) once you need to email other people.
RESEND_FROM_EMAIL=

# The public URL of this deployment — used as the "Open Wayrise" link in
# digest emails, since a background email job has no incoming request to
# derive it from. Defaults to http://localhost:3000 if unset.
APP_URL=

# Push reminders (real OS-level notifications — overdue alerts, due-today
# pings, recurring focus nudges) need NO setup at all: the server generates
# its own VAPID keypair on first use and stores it in the database, unlike
# every other integration above. VAPID_CONTACT_EMAIL is optional — just an
# email address push services may contact if your server is misbehaving
# (sending too much, etc). Defaults to admin@example.com if unset.
VAPID_CONTACT_EMAIL=

# Sign in with Microsoft + OneDrive backup (optional) — see README → Setup.
# Redirect URIs: <APP_URL>/api/auth/microsoft/callback and <APP_URL>/api/onedrive/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Who can open the owner Metrics page (comma-separated). Unset = the first
# account created on this server.
ADMIN_EMAILS=

# ── Wayrise Pro (Stripe) ─────────────────────────────────────────
# Leave empty and nothing is for sale; everything stays free.
# 1. In Stripe: Products > add "Wayrise Pro" with a monthly (and yearly) price.
# 2. Developers > API keys: the secret key.
# 3. Developers > Webhooks > Add endpoint: https://YOUR-DOMAIN/api/stripe/webhook
#    with events checkout.session.completed and customer.subscription.created,
#    .updated and .deleted; copy its signing secret.
# 4. Settings > Billing > Customer portal: turn it on (cancel, switch plan, update card).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Music search in "Your why" (optional). Without these, search uses Apple's
# free catalogue (songs). With them, it searches Spotify (songs and
# playlists). Create a free app at https://developer.spotify.com/dashboard
# and copy its Client ID and Client secret. No user sign-in is involved.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# The same Spotify app also lets people link their own Spotify account to
# bring in their playlists. In the Spotify dashboard, add this Redirect URI:
#   <APP_URL>/api/music/spotify/callback
# (While the Spotify app is in development mode, only up to 25 people you
# add under "User Management" can link; ask Spotify for an extension to
# open it to everyone.)
#
# YouTube: search (full songs that play in the app) needs an API key from
# Google Cloud with the "YouTube Data API v3" turned on. Linking someone's
# YouTube account reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above; add
# this Authorized redirect URI to that Google OAuth client:
#   <APP_URL>/api/music/youtube/callback
# and add the youtube.readonly scope to its consent screen.
YOUTUBE_API_KEY=
