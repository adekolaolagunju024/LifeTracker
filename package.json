{
  "name": "waypoint",
  "version": "1.0.0",
  "description": "A general-purpose personal goal tracker",
  "main": "backend/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "showcase": "node backend/showcase.js",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.css -o frontend/css/app.css --minify && tailwindcss -c tailwind.site.config.js -i styles/tailwind.css -o frontend/css/site.css --minify",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^11.4.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "esbuild": "0.25.10",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "googleapis": "^180.0.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "puppeteer-core": "^25.10.0",
    "qrcode": "^1.5.4",
    "resend": "^6.32.0",
    "three": "^0.186.1",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemon": "^3.0.1",
    "tailwindcss": "^3.4.17"
  }
}
